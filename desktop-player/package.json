{
  "name": "subhumusic-desktop",
  "version": "0.1.0",
  "description": "Standalone SubhuMusic desktop audio and video player",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.subhadip.subhumusic.desktop",
    "productName": "SubhuMusic",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "bin/yt-dlp.exe",
        "to": "yt-dlp.exe"
      },
      {
        "from": "bin/deno.exe",
        "to": "deno.exe"
      }
    ]
  }
}
